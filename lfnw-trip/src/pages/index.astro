---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
const base = '/lfnw-trip';
---

<Layout title="LFNW Trip — LinuxFest Northwest 2027">
  <Nav />
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <p class="hero-label">Solo Road Trip · April 2027</p>
        <h1>LinuxFest Northwest<br/><span class="hero-sub">Bellingham, Washington</span></h1>
        <p class="hero-desc">
          LFNW, Apr 23–25 · Three days of Linux and open source at Bellingham Technical College, a drive up I-5, and ice cream selfies in Fairhaven.
        </p>
        <div class="hero-actions">
          <a href={`${base}/bellingham/`} class="btn btn-primary">Explore Bellingham →</a>
          <a href={`${base}/checklist/`} class="btn btn-secondary">Planning Checklist</a>
        </div>
      </div>
    </section>

    <div class="container">
      <!-- Trip at a Glance -->
      <section class="section">
        <p class="section-label">Trip Overview</p>
        <h2>At a Glance</h2>
        <div class="glance-grid" style="margin-top:1rem;">
          <div class="glance-card">
            <div class="glance-icon">📅</div>
            <div>
              <div class="glance-label">Dates</div>
              <div class="glance-value">Apr 23–25, 2027 (3 days)</div>
            </div>
          </div>
          <div class="glance-card">
            <div class="glance-icon">✈️</div>
            <div>
              <div class="glance-label">Transport</div>
              <div class="glance-value">Driving Seattle → Bellingham (~90 mi, ~2 hrs each way)</div>
            </div>
          </div>
          <div class="glance-card">
            <div class="glance-icon">🐧</div>
            <div>
              <div class="glance-label">Conference</div>
              <div class="glance-value">LinuxFest Northwest, Apr 23–25</div>
            </div>
          </div>
          <div class="glance-card">
            <div class="glance-icon">🌡️</div>
            <div>
              <div class="glance-label">Weather</div>
              <div class="glance-value">Cool and showery · check forecast closer to the trip</div>
            </div>
          </div>
          <div class="glance-card">
            <div class="glance-icon">💵</div>
            <div>
              <div class="glance-label">Est. Budget</div>
              <div class="glance-value">~$1,039 USD (solo)</div>
            </div>
          </div>
          <div class="glance-card">
            <div class="glance-icon">🍦</div>
            <div>
              <div class="glance-label">Ice Cream Selfies</div>
              <div class="glance-value">4 spots planned (Mallard, Sirena, Acme Valley, Edaleen)</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Conference section -->
      <section class="section">
        <p class="section-label">LinuxFest Northwest</p>
        <h2>The Conference</h2>
        <div class="conf-card card" style="margin-top:1rem;">
          <div class="conf-body">
            <div class="conf-text">
              <p>
                <strong>LinuxFest Northwest (LFNW)</strong> is a free-to-attend, community-run Linux and open source
                conference held at Bellingham Technical College since 2000. LFNW 2027 runs April 23–25 and is co-produced
                with Jupiter Broadcasting.
              </p>
              <p style="margin-top:.75rem;">
                The LFNW site does not yet publish a schedule, attendee registration details, or lodging info,
                so some details below are estimates. Check
                <a href="https://www.linuxfestnorthwest.org/" target="_blank" rel="noopener">linuxfestnorthwest.org</a> for updates.
              </p>
              <div class="conf-details">
                <span>📅 April 23–25, 2027</span>
                <span>📍 Bellingham, WA</span>
                <span>🐧 Open source · Linux · Community</span>
              </div>
            </div>
            <div class="conf-links">
              <a href="https://www.linuxfestnorthwest.org/" target="_blank" rel="noopener" class="btn btn-primary">LFNW Website →</a>
              <a href={`${base}/checklist/`} class="btn btn-outline">Pre-trip Checklist</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Quick nav -->
      <section class="section">
        <p class="section-label">Navigate</p>
        <h2>Plan Your Trip</h2>
        <div class="nav-cards" style="margin-top:1rem;">
          <a href={`${base}/bellingham/`} class="nav-card card">
            <div class="nc-icon">🌲</div>
            <div class="nc-text">
              <div class="nc-title">Bellingham</div>
              <div class="nc-desc">Hotels, restaurants, itinerary, map, ice cream spots</div>
            </div>
          </a>
          <a href={`${base}/checklist/`} class="nav-card card">
            <div class="nc-icon">✅</div>
            <div class="nc-text">
              <div class="nc-title">Checklist</div>
              <div class="nc-desc">Pre-trip planning tasks with progress tracking</div>
            </div>
          </a>
          <a href={`${base}/budget/`} class="nav-card card">
            <div class="nc-icon">💰</div>
            <div class="nc-text">
              <div class="nc-title">Budget</div>
              <div class="nc-desc">Estimated costs with expense tracking and charts</div>
            </div>
          </a>
          <a href={`${base}/log/`} class="nav-card card">
            <div class="nc-icon">📝</div>
            <div class="nc-text">
              <div class="nc-title">Expense Log</div>
              <div class="nc-desc">Quick mobile-optimized expense entry</div>
            </div>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--wa-primary) 0%, var(--wa-accent) 100%);
    color: white;
    padding: 3.5rem 0 3rem;
    text-align: center;
  }
  .hero-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 0.5rem;
  }
  .hero h1 { color: white; line-height: 1.15; }
  .hero-sub { color: rgba(255,255,255,0.85); font-style: italic; }
  .hero-desc { max-width: 520px; margin: 1rem auto; color: rgba(255,255,255,0.85); font-size: 1.05rem; }
  .hero-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }

  .glance-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1rem; }
  .glance-card {
    background: white;
    border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    box-shadow: var(--shadow);
  }
  .glance-icon { font-size: 1.5rem; flex-shrink: 0; }
  .glance-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gray-500); margin-bottom: 0.1rem; }
  .glance-value { font-size: 0.92rem; color: var(--gray-900); font-weight: 500; }

  .conf-card { padding: 1.5rem; }
  .conf-body { display: flex; gap: 2rem; align-items: flex-start; }
  .conf-text { flex: 1; font-size: 0.95rem; color: var(--gray-700); line-height: 1.6; }
  .conf-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--wa-accent);
    font-weight: 500;
  }
  .conf-links { display: flex; flex-direction: column; gap: 0.6rem; flex-shrink: 0; }

  .nav-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .nav-card {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--gray-900);
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .nav-card:hover { box-shadow: var(--shadow-md); border-color: var(--wa-primary); text-decoration: none; }
  .nc-icon { font-size: 1.75rem; flex-shrink: 0; }
  .nc-title { font-weight: 600; font-size: 1rem; color: var(--gray-900); margin-bottom: 0.2rem; }
  .nc-desc { font-size: 0.85rem; color: var(--gray-500); }

  @media (max-width: 640px) {
    .conf-body { flex-direction: column; }
    .conf-links { flex-direction: row; flex-wrap: wrap; }
  }
</style>
